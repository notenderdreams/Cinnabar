{
  "name": "cinnabar",
  "version": "0.1.0",
  "description": "Ultra-Smooth High-Performance Desktop PDF Reader, Inverting & Annotation Studio",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky",
    "lint:staged": "bunx --bun lint-staged",
    "knip": "knip",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "audit:rust": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun test",
    "dev": "tauri dev",
    "dev:frontend": "bun run generate:bindings && vite",
    "build": "tauri build",
    "build:frontend": "bun run generate:bindings && tsc && vite build",
    "generate:bindings": "cargo test --manifest-path src-tauri/Cargo.toml exports_typescript_bindings --quiet"
  },
  "dependencies": {
    "@cinnabar/notebook": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/core": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "canvas-confetti": "^1.9.4",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.2.1"
  }
}
